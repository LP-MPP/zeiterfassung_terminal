{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "zeiterfassung-ebafa",
          "appId": "1:1033669882029:android:26b5a794bbad3ec7c4d624",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "zeiterfassung-ebafa",
          "configurations": {
            "android": "1:1033669882029:android:ae0373c609fe0b8dc4d624",
            "web": "1:1033669882029:web:0c3c503c37e65247c4d624"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/updates/update.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/releases/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=zeiterfassung-terminal.apk"
          }
        ]
      },
      {
        "source": "/app.apk",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/terminal.apk",
        "destination": "/releases/zeiterfassung-terminal-1.2.6-9.apk",
        "type": 302
      },
      {
        "source": "/app.apk",
        "destination": "/releases/zeiterfassung-terminal-1.2.6-9.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
