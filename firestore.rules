rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin');
    }

    function canWriteAdminData() {
      return isAdminUser() && adminRole() in ['superadmin', 'admin'];
    }

    // Terminal app
    match /employees/{employeeId} {
      allow read: if isAdminUser();
      allow create, update: if canWriteAdminData();
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isAdminUser();
      allow create: if canWriteAdminData();
      allow update, delete: if false;
    }

    match /employee_state/{employeeId} {
      allow read: if isAdminUser();
      allow write: if canWriteAdminData();
    }

    match /terminal_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /login_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /config/terminal {
      allow read: if isSignedIn();
      allow create, update: if canWriteAdminData();
      allow delete: if false;
    }

    // Admin app data
    match /day_overrides/{overrideId} {
      allow read: if isAdminUser();
      allow write: if false; // Only through month-locking Cloud Functions.
    }

    match /audit/{auditId} {
      allow read: if isAdminUser();
      // Append-only (GoBD): public entries are written by trusted Functions.
      allow create: if canWriteAdminData();
      allow update, delete: if false;
    }

    match /month_approvals/{approvalId} {
      allow read: if isAdminUser();
      allow write: if canWriteAdminData();
    }

    // Absence management
    match /absences/{absenceId} {
      allow read: if isAdminUser();
      // All mutations pass through Functions which enforce state transitions,
      // month locks, special-leave validation and the matching audit entry.
      allow create, update, delete: if false;
    }

    match /vacation_balances/{balanceId} {
      // Employees receive only their own balance through a Cloud Function.
      allow read: if isAdminUser();
      allow write: if canWriteAdminData();
    }

    match /public_holidays/{holidayId} {
      allow read: if isSignedIn();
      allow write: if canWriteAdminData();
    }

    // Employee profiles (personal data)
    match /employee_profiles/{profileId} {
      allow read: if isAdminUser();
      allow write: if canWriteAdminData();
    }

    // Public clients receive only minimal invitation metadata through a Function.
    // Submitted personnel data is never readable through a bearer link.
    match /onboarding_requests/{requestId} {
      allow read: if isAdminUser();
      allow create, update, delete: if canWriteAdminData();
    }

    // Sign requests — public access only with the exact token (= doc ID).
    match /sign_requests/{requestId} {
      allow get: if true;
      allow list: if isAdminUser();
      allow create, update, delete: if canWriteAdminData();
    }

    // Email trigger (Firebase Extension reads this)
    match /mail/{mailId} {
      allow create: if canWriteAdminData();
      allow read, update, delete: if false;
    }

    match /onboarding_email_jobs/{jobId} {
      allow create: if canWriteAdminData();
      allow read, update, delete: if false;
    }

    // Admin users
    match /admins/{adminId} {
      allow read: if isAdminUser();
      allow write: if false; // Only via Cloud Functions
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
